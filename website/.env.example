# Supabase Postgres connection URI: use Session pooler (5432) for the Dokploy server.
# Copy from Connect; URL-encode the database password and enable SSL.
DATABASE_URL=
# Optional direct/session URI for migrations; defaults to DATABASE_URL.
DATABASE_MIGRATION_URL=
BETTER_AUTH_URL=https://qyube.brokarim.com
TRUSTED_PROXY_COUNT=1
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
POLAR_ACCESS_TOKEN=
POLAR_ENVIRONMENT=sandbox
POLAR_WEBHOOK_SECRET=
BILLING_JOB_TOKEN=
# Legacy subscriptions remain recognized for existing paid access only.
POLAR_MONTHLY_PRODUCT_ID=
POLAR_ANNUAL_PRODUCT_ID=
# Required product for new one-time Qyube Pro purchases.
POLAR_LIFETIME_PRODUCT_ID=
EXPECTED_LIFETIME_AMOUNT_CENTS=1100
MIN_LIFETIME_AMOUNT_CENTS=500
ENTITLEMENT_SIGNING_PRIVATE_KEY=
ENTITLEMENT_SIGNING_PUBLIC_KEY=
